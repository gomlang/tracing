package tracing;

use std::bytes;
use std::io;
use io::Write;

pub struct Sink {
    write: (Record) -> Result[(), Error],
    flush: () -> Result[(), Error],
    finish: () -> Result[(), Error],
    group_depth: isize,
}

impl Sink {
    pub fn new(
        write: (Record) -> Result[(), Error],
        flush: () -> Result[(), Error],
        finish: () -> Result[(), Error],
    ) -> Sink {
        Sink { write, flush, finish, group_depth: 0 }
    }

    pub fn from_callback(write: (Record) -> Result[(), Error]) -> Sink {
        Sink::new(write, || Result::Ok(()), || Result::Ok(()))
    }

    pub fn fanout(sinks: Vec[Sink]) -> Sink {
        let sinks = sinks.freeze();
        Sink::new(
            |record| {
                let mut error = Option::None;
                for sink in sinks.iter() {
                    if let Err(problem) = (sink.write)(record) {
                        if error.is_none() {
                            error = Option::Some(problem);
                        }
                    }
                }
                match error {
                    Some(error) => Result::Err(error),
                    None => Result::Ok(()),
                }
            },
            || {
                let mut error = Option::None;
                for sink in sinks.iter() {
                    if let Err(problem) = (sink.flush)() {
                        if error.is_none() {
                            error = Option::Some(problem);
                        }
                    }
                }
                match error {
                    Some(error) => Result::Err(error),
                    None => Result::Ok(()),
                }
            },
            || {
                let mut error = Option::None;
                for sink in sinks.iter() {
                    if let Err(problem) = (sink.finish)() {
                        if error.is_none() {
                            error = Option::Some(problem);
                        }
                    }
                }
                match error {
                    Some(error) => Result::Err(error),
                    None => Result::Ok(()),
                }
            },
        )
    }

    pub fn filtered(self: Sink, filter: Filter) -> Sink {
        Sink {
            group_depth: self.group_depth,
            write: |record| if filter.enabled(record.metadata) {
                (self.write)(record)
            } else {
                Result::Ok(())
            },
            flush: self.flush,
            finish: self.finish,
        }
    }

    pub fn writer[W: Write](writer: W, format: Format) -> Sink {
        Sink::new(
            |record| {
                let line = match format {
                    Json => record.json_line(),
                    Text => record.text_line(),
                };
                writer.write_all(bytes::Bytes::from_string(line).as_slice()).map_err(
                    |error| Error::sink(error.to_string()),
                )
            },
            || writer.flush().map_err(|error| Error::sink(error.to_string())),
            || Result::Ok(()),
        )
    }
}

#[derive(Debug, PartialEq)]
pub enum Format {
    Json,
    Text,
}

pub struct MemorySink {
    state: Channel[Vec[Record]],
    capacity: Option[isize],
}

impl MemorySink {
    pub fn new() -> MemorySink {
        let state = Channel::new(1);
        state.send(Vec::new());
        MemorySink { state, capacity: Option::None }
    }

    pub fn bounded(capacity: isize) -> Result[MemorySink, Error] {
        if capacity < 1 || capacity > 1000000 {
            return Result::Err(
                Error {
                    kind: ErrorKind::InvalidInput,
                    message: "memory sink capacity must be 1 through 1000000",
                },
            )
        }
        Result::Ok(MemorySink { capacity: Option::Some(capacity), ..MemorySink::new() })
    }

    pub fn drain(self: MemorySink) -> Vec[Record] {
        let values = self.state.recv().unwrap_or(Vec::new());
        self.state.send(Vec::new());
        values
    }

    pub fn records(self: MemorySink) -> Vec[Record] {
        let values = self.state.recv().unwrap_or(Vec::new());
        let copy = values.copy();
        self.state.send(values);
        copy
    }

    pub fn sink(self: MemorySink) -> Sink {
        Sink::from_callback(
            |record| {
                let values = self.state.recv().unwrap_or(Vec::new());
                if let Some(capacity) = self.capacity {
                    if values.len() >= capacity {
                        self.state.send(values);
                        return Result::Err(Error::sink("memory sink capacity exceeded"))
                    }
                }
                values.push(record);
                self.state.send(values);
                Result::Ok(())
            },
        )
    }
}
